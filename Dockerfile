# syntax=docker/dockerfile:1
#
# Targets:
#   docker build --target lock --output type=local,dest=. .   # refresh requirements-lock.txt
#   docker build --target test .                               # pytest inside the image
#   docker build .                                             # runtime image (default)
#
# Layout inside the image mirrors the workspace, so config.yaml's relative
# paths (../fr5_teleop/...) work unchanged:
#   /ws/fr5_infer    this project
#   /ws/fr5_teleop   teleop package, web/ and Fairino SDK copied from the
#                    fr5_teleop image (TELEOP_IMAGE), config.yaml mounted
#
# The checkpoint is never baked in: mount it at /ws/fr5_infer/checkpoints.
# torch cu128 wheels carry the CUDA runtime; the host needs only the NVIDIA
# driver and nvidia-container-toolkit.

ARG TELEOP_IMAGE=ghcr.io/benlee-robotics/fr5_teleop:0.4.3

FROM ${TELEOP_IMAGE} AS teleop


# Python 3.12: lerobot 0.6 requires it (the training PC runs lerobot 0.6.2).
FROM python:3.12-slim-bookworm AS base

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# libusb: pyrealsense2 links the system one. git: lerobot git pin.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libusb-1.0-0 git \
    && rm -rf /var/lib/apt/lists/*


FROM base AS lock-build

COPY requirements.txt /tmp/req/
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install -r /tmp/req/requirements.txt \
    && { echo "# Generated by: docker build --target lock --output type=local,dest=. ."; \
         echo "--extra-index-url https://download.pytorch.org/whl/cu128"; \
         python -m pip freeze; } > /requirements-lock.txt


FROM scratch AS lock

COPY --from=lock-build /requirements-lock.txt /


FROM base AS deps

COPY requirements-lock.txt /tmp/req/
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install -r /tmp/req/requirements-lock.txt

COPY --from=teleop /app/teleop/ /ws/fr5_teleop/teleop/
COPY --from=teleop /app/web/ /ws/fr5_teleop/web/
COPY --from=teleop /app/fairino-python-sdk-2.2.8_robot_v3.9.8/ \
    /ws/fr5_teleop/fairino-python-sdk-2.2.8_robot_v3.9.8/
# Default teleop config (fake mode works with it); the field config is mounted over it.
COPY --from=teleop /app/config.yaml /ws/fr5_teleop/config.yaml

WORKDIR /ws/fr5_infer


FROM deps AS test

RUN --mount=type=cache,target=/root/.cache/pip python -m pip install pytest==8.4.1
COPY . /ws/fr5_infer
RUN python -m pytest -p no:cacheprovider -q


FROM deps AS runtime

ARG INFER_UID=1000
ARG INFER_GID=1000
RUN groupadd --gid "${INFER_GID}" infer \
    && useradd --uid "${INFER_UID}" --gid "${INFER_GID}" --create-home \
        --shell /usr/sbin/nologin infer

COPY fr5_infer/ /ws/fr5_infer/fr5_infer/
COPY scripts/ /ws/fr5_infer/scripts/
COPY config.yaml pyproject.toml README.md /ws/fr5_infer/
RUN mkdir -p /ws/fr5_infer/runs /ws/fr5_infer/checkpoints \
    && chown infer:infer /ws/fr5_infer/runs

# Never wait on the HuggingFace Hub at the robot.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HOME=/home/infer/.cache/huggingface

USER infer

LABEL org.opencontainers.image.source="https://github.com/benlee-robotics/fr5_infer" \
      org.opencontainers.image.description="Run a LeRobot policy checkpoint (Pi0.5) on the Fairino FR5"

ENTRYPOINT ["python", "-m", "fr5_infer"]
